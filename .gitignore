# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Secrets
.env
*.key

# Large / regenerable data
data/raw/
data/static/raw_cdragon/
data/stats/*.sqlite
data/stats/*.sqlite-wal
data/stats/*.sqlite-shm
data/stats/*.sqlite-journal

# Local Claude Code settings
.claude/settings.local.json

# Logs
logs/
*.log

# 실행 상태(세션 추적, 오버레이 위치) — 기기·판마다 다르다
_state/

# Riot 게임 에셋(아이템 아이콘) — 커밋하지 않는다. data/templates/README.md 참고
#  items/        : CommunityDragon에서 받은 아이콘(`python -m tft_advisor.vision.templates fetch-items`로 재생성)
#  items_screen/ : 사용자 캡처에서 잘라낸 실화면 아이콘(`harvest-items`로 재생성, 역시 Riot 아트워크)
data/templates/*/items/
data/templates/*/items_screen/

# Debug renders of screen crops (Riot art, regenerable)
_workspace/*.png

# Raw game captures: Riot art + other players' summoner names (repo is public)
tests/fixtures/screens/raw/

# macOS
.DS_Store
