# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Secrets
.env
*.key

# Large / regenerable data
data/raw/
data/static/raw_cdragon/
data/stats/*.sqlite
data/stats/*.sqlite-wal
data/stats/*.sqlite-shm
data/stats/*.sqlite-journal

# Local Claude Code settings
.claude/settings.local.json

# Logs
logs/
*.log

# 실행 상태(세션 추적, 오버레이 위치) — 기기·판마다 다르다
_state/

# Riot 게임 에셋(아이템 아이콘) — 커밋하지 않는다. data/templates/README.md 참고
#  items/        : CommunityDragon에서 받은 아이콘(`python -m tft_advisor.vision.templates fetch-items`로 재생성)
#  items_screen/ : 사용자 캡처에서 잘라낸 실화면 아이콘(`harvest-items`로 재생성, 역시 Riot 아트워크)
data/templates/*/items/
data/templates/*/items_screen/
#  augments/        : CommunityDragon 증강 글리프(`fetch-augments`), augments_screen/: 캡처에서 잘라낸 보유 증강 칸(`harvest-augments`)
data/templates/*/augments/
data/templates/*/augments_screen/
#  augments_alt/    : CDragon에 없는 세트 증강의 대체 출처 아이콘(tactics.tools 경유 Riot 아트, `fetch-augments`) + sources.json
data/templates/*/augments_alt/

# Debug renders of screen crops (Riot art, regenerable)
_workspace/*.png

# Raw game captures: Riot art + other players' summoner names (repo is public)
tests/fixtures/screens/raw/

# macOS
.DS_Store

# 설정 화면(--setup)이 저장 전에 남기는 백업
config/*.bak

# 자격 증명은 저장소 밖(OS 키체인 / ~/.config/tft-advisor/)에만 둔다. 실수로 들어와도 커밋되지 않게.
credentials.toml
